# Homebrew secure defaults — sourced by login shells and by brew-secure.
# See: https://docs.brew.sh/Manpage#environment
#      https://docs.brew.sh/Homebrew-Security-and-Supply-Chain

# Forbid HTTPS → HTTP download redirects.
export HOMEBREW_NO_INSECURE_REDIRECT=1

# Opt out of analytics.
export HOMEBREW_NO_ANALYTICS=1

# Refuse formula/cask installs from arbitrary local paths.
export HOMEBREW_FORBID_PACKAGES_FROM_PATHS=1

# Require cask checksums (append; do not clobber existing opts).
case " ${HOMEBREW_CASK_OPTS-} " in
  *" --require-sha "*) ;;
  *) export HOMEBREW_CASK_OPTS="${HOMEBREW_CASK_OPTS:+${HOMEBREW_CASK_OPTS} }--require-sha" ;;
esac

# Verify bottle build-provenance attestations (uses `gh`; brew may install it).
export HOMEBREW_VERIFY_ATTESTATIONS=1
